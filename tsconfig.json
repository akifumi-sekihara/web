{
  "extends": "@portfolio/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "worker/**/*.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "scripts/**/*.mjs"
  ]
}
