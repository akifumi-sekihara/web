{
  "name": "web",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter portfolio-web dev",
    "build": "pnpm --filter portfolio-web build",
    "check-types": "pnpm --filter portfolio-web check-types",
    "check": "pnpm lint && pnpm format:check && pnpm check-types && pnpm check:config && pnpm check:deps",
    "lint": "vp lint",
    "format": "vp fmt",
    "dev:web": "pnpm --filter portfolio-web dev",
    "deploy": "pnpm check && pnpm build && wrangler deploy",
    "fix": "vp check --fix",
    "format:check": "vp fmt --check",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "preview": "wrangler dev",
    "prepare": "lefthook install",
    "check:deps": "knip",
    "test": "node --experimental-strip-types --test tests/language.test.ts",
    "test:browser": "playwright test",
    "check:site": "node scripts/check-site.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "check:config": "tsc --noEmit -p tsconfig.json",
    "audit:deps": "pnpm audit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@portfolio/config": "workspace:*",
    "@types/node": "catalog:",
    "chrome-launcher": "^1.2.1",
    "html-validate": "^11.15.0",
    "knip": "6.34.0",
    "lefthook": "2.1.12",
    "lighthouse": "13.4.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "catalog:",
    "ultracite": "7.11.0",
    "vite-plus": "0.3.0",
    "wrangler": "4.129.1"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=11.15.1 <12"
  },
  "packageManager": "pnpm@11.15.1"
}
